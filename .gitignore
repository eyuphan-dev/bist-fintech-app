# Environment / secrets
#
# TUM .env turevleri yoksayilir, YALNIZCA .env.example takip edilir.
# Onceki kurallar yalnizca bilinen adlari sayiyordu (.env, .env.local) ve
# .env.bak-20260823, .env.prod gibi turevleri KAPSAMIYORDU — sunucuda
# olusan iki yedek bu yuzden "takip edilmeyen" olarak goruluyordu, yani
# dikkatsiz bir `git add -A` onlari commit edebilirdi.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
backend/venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Databases (local SQLite data — never committed)
*.db
*.db-journal
*.db.bak_*
backend/bist_app.db

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
frontend/.turbo/
node_modules/

# Logs / OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Kişisel deploy notları (yalnızca yerelde, repoya dahil değil)
eyup.md

# GitHub'da YALNIZCA README.md gorunsun; diger tum .md dosyalari
# yerelde kalir (proje notlari, calisma dosyalari).
*.md
!README.md
