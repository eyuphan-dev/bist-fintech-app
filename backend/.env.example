# Prod'da zorunlu — imzalama anahtarı, kesinlikle sabit kodlanmamalı
JWT_SECRET_KEY=change-me-to-a-long-random-string

ENVIRONMENT=production

# Frontend'in çalıştığı URL (CORS için) — örn. https://borsa-trader.duckdns.org
FRONTEND_URL=https://your-domain.example

# Postgres bağlantısı — tanımlı değilse yerel SQLite'a düşer (yalnızca geliştirme için)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
